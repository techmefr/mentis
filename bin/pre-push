#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-push: running bin/test_scripts.py, bin/test_local.py, bin/test_hooks.py"

fail=0
for suite in bin/test_scripts.py bin/test_local.py bin/test_hooks.py; do
  if ! python3 "$suite"; then
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo "pre-push: at least one suite failed, refusing to push" >&2
  exit 1
fi

echo "pre-push: all suites green"
